{
  "version": "2.0.0",
  "tasks": [
    // ============================================================
    // Build & Test
    // ============================================================
    {
      "label": "nssmr: build",
      "type": "process",
      "command": "make",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}\\build.ps1",
          "build"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "nssmr: test",
      "type": "process",
      "command": "make",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\build.ps1", "test"]
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },

    // ============================================================
    // Windows Artifacts
    // ============================================================
    {
      "label": "nssmr: build-windows",
      "type": "process",
      "command": "make",
      "args": ["build-windows"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}\\build.ps1",
          "build-windows"
        ]
      }
    },
    {
      "label": "nssmr: build-windows-amd64",
      "type": "process",
      "command": "make",
      "args": ["build-windows-amd64"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}\\build.ps1",
          "build-windows-amd64"
        ]
      }
    },
    {
      "label": "nssmr: build-windows-arm64",
      "type": "process",
      "command": "make",
      "args": ["build-windows-arm64"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}\\build.ps1",
          "build-windows-arm64"
        ]
      }
    },

    // ============================================================
    // Code Quality
    // ============================================================
    {
      "label": "nssmr: vet",
      "type": "process",
      "command": "make",
      "args": ["vet"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\build.ps1", "vet"]
      }
    },
    {
      "label": "nssmr: lint",
      "type": "process",
      "command": "make",
      "args": ["lint"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\build.ps1", "lint"]
      }
    },
    {
      "label": "nssmr: fmt",
      "type": "process",
      "command": "make",
      "args": ["fmt"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\build.ps1", "fmt"]
      }
    },

    // ============================================================
    // Formatting & Docs
    // ============================================================
    {
      "label": "nssmr: prettier-check",
      "type": "process",
      "command": "npx",
      "args": [
        "prettier",
        "--check",
        ".",
        "--config",
        ".prettierrc.json",
        "--ignore-path",
        ".prettierignore"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "nssmr: prettier-format",
      "type": "process",
      "command": "npx",
      "args": [
        "prettier",
        "--write",
        ".",
        "--config",
        ".prettierrc.json",
        "--ignore-path",
        ".prettierignore"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "nssmr: markdownlint-cli2-check",
      "type": "process",
      "command": "npx",
      "args": [
        "markdownlint-cli2",
        "--config",
        ".markdownlint-cli2.jsonc",
        "**/*.md",
        "#.gocache",
        "#.gomodcache",
        "#.idea",
        "#dist",
        "#tmp",
        "#**/*.go",
        "#CHANGELOG.md",
        "#node_modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "nssmr: markdownlint-cli2-fix",
      "type": "process",
      "command": "npx",
      "args": [
        "markdownlint-cli2",
        "--config",
        ".markdownlint-cli2.jsonc",
        "--fix",
        "**/*.md",
        "#.gocache",
        "#.gomodcache",
        "#.idea",
        "#dist",
        "#tmp",
        "#**/*.go",
        "#CHANGELOG.md",
        "#node_modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },

    // ============================================================
    // Cleanup
    // ============================================================
    {
      "label": "nssmr: clean",
      "type": "process",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}\\build.ps1",
          "clean"
        ]
      }
    }
  ]
}
